# Dependencies
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# env files — real secrets only. Precise (not a blanket .env*) so
# .env.example stays trackable — it documents required vars, not a secret
# itself (§3.3). Matches the root .gitignore's pattern.
.env
.env.local
.env*.local
