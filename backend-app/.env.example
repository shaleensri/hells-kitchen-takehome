# OpenAI key for the "Ask about this recipe" panel (Iteration 6, PLAN.md §3.3).
# Server-side only — never sent to the browser. If unset, the feature fails
# soft: GET /api/llm-status reports { available: false }, the frontend shows
# a disabled state, and POST /api/recipes/:id/ask returns 503 rather than
# crashing anything else in the app.
OPENAI_API_KEY=

# Optional override for the pinned model string in src/llm.ts (§3.11) — only
# needed if the default (gpt-4o-mini) becomes unavailable/deprecated before
# this gets redeployed.
# OPENAI_MODEL=gpt-4o-mini
